--
-- Data for Name: schema_migrations; Type: TABLE DATA; Schema: supabase_migrations; Owner: postgres
--

COPY supabase_migrations.schema_migrations (version, statements, name, created_by, idempotency_key, rollback) FROM stdin;
20251203234146	{"-- Enable UUID extension\nCREATE EXTENSION IF NOT EXISTS \\"uuid-ossp\\";\n\n-- ============================================\n-- 1. PROFILES TABLE\n-- ============================================\nCREATE TABLE IF NOT EXISTS profiles (\n  id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,\n  email TEXT,\n  full_name TEXT,\n  timezone TEXT DEFAULT 'UTC',\n  default_currency TEXT DEFAULT 'USD',\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\n-- ============================================\n-- 2. TRADING ACCOUNTS TABLE\n-- ============================================\nCREATE TABLE IF NOT EXISTS trading_accounts (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  user_id UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,\n  account_name TEXT NOT NULL,\n  broker_name TEXT,\n  account_number TEXT,\n  account_type TEXT, -- 'demo', 'live', 'paper'\n  currency TEXT DEFAULT 'USD',\n  initial_balance NUMERIC(15, 2) DEFAULT 0,\n  current_balance NUMERIC(15, 2) DEFAULT 0,\n  is_active BOOLEAN DEFAULT true,\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\n-- ============================================\n-- 3. STRATEGIES TABLE\n-- ============================================\nCREATE TABLE IF NOT EXISTS strategies (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  user_id UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,\n  name TEXT NOT NULL,\n  description TEXT,\n  rules TEXT, -- JSON or text description of strategy rules\n  timeframes TEXT[], -- Array of timeframes like ['H1', 'H4', 'D1']\n  is_active BOOLEAN DEFAULT true,\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\n-- ============================================\n-- 4. TRADE SETUPS TABLE\n-- ============================================\nCREATE TABLE IF NOT EXISTS trade_setups (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  user_id UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,\n  strategy_id UUID REFERENCES strategies(id) ON DELETE SET NULL,\n  name TEXT NOT NULL,\n  description TEXT,\n  pattern_type TEXT, -- 'breakout', 'reversal', 'trend_following', etc.\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\n-- ============================================\n-- 5. EMOTION TAGS TABLE\n-- ============================================\nCREATE TABLE IF NOT EXISTS emotion_tags (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  user_id UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,\n  name TEXT NOT NULL,\n  color TEXT, -- Hex color for UI\n  is_default BOOLEAN DEFAULT false, -- System-provided defaults\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  UNIQUE(user_id, name)\n);\n\n-- ============================================\n-- 6. MISTAKE TAGS TABLE\n-- ============================================\nCREATE TABLE IF NOT EXISTS mistake_tags (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  user_id UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,\n  name TEXT NOT NULL,\n  description TEXT,\n  is_default BOOLEAN DEFAULT false, -- System-provided defaults\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  UNIQUE(user_id, name)\n);\n\n-- ============================================\n-- 7. TRADES TABLE (MAIN TABLE)\n-- ============================================\nCREATE TABLE IF NOT EXISTS trades (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  user_id UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,\n  account_id UUID NOT NULL REFERENCES trading_accounts(id) ON DELETE CASCADE,\n  \n  -- Trade identification\n  ticket_id TEXT, -- Broker ticket/order ID\n  currency_pair TEXT NOT NULL, -- e.g., 'EURUSD', 'GBPUSD'\n  direction TEXT NOT NULL CHECK (direction IN ('buy', 'sell')),\n  \n  -- Entry details\n  entry_time TIMESTAMPTZ NOT NULL,\n  entry_price NUMERIC(15, 5) NOT NULL,\n  position_size NUMERIC(15, 2) NOT NULL, -- Lot size\n  \n  -- Exit details\n  exit_time TIMESTAMPTZ,\n  exit_price NUMERIC(15, 5),\n  \n  -- Risk management\n  stop_loss NUMERIC(15, 5),\n  take_profit NUMERIC(15, 5),\n  risk_amount NUMERIC(15, 2), -- Risk in account currency\n  risk_reward_ratio NUMERIC(10, 2),\n  \n  -- Results\n  profit_loss NUMERIC(15, 2) DEFAULT 0, -- P&L in account currency\n  pips NUMERIC(10, 2), -- Pips gained/lost\n  r_multiple NUMERIC(10, 2), -- Risk multiple (P&L / Risk)\n  \n  -- Psychology & Context\n  conviction_level INTEGER CHECK (conviction_level >= 1 AND conviction_level <= 10),\n  market_conditions TEXT,\n  rule_followed BOOLEAN,\n  execution_rating INTEGER CHECK (execution_rating >= 1 AND execution_rating <= 10),\n  lessons_learned TEXT,\n  \n  -- Strategy & Setup\n  strategy_id UUID REFERENCES strategies(id) ON DELETE SET NULL,\n  setup_id UUID REFERENCES trade_setups(id) ON DELETE SET NULL,\n  \n  -- Status\n  status TEXT DEFAULT 'open' CHECK (status IN ('open', 'closed', 'pending')),\n  \n  -- Metadata\n  notes TEXT,\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW(),\n  \n  -- Prevent duplicate ticket IDs per account\n  UNIQUE(account_id, ticket_id)\n);\n\n-- ============================================\n-- 8. TRADE EMOTIONS (JUNCTION TABLE)\n-- ============================================\nCREATE TABLE IF NOT EXISTS trade_emotions (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  trade_id UUID NOT NULL REFERENCES trades(id) ON DELETE CASCADE,\n  emotion_id UUID NOT NULL REFERENCES emotion_tags(id) ON DELETE CASCADE,\n  timing TEXT NOT NULL CHECK (timing IN ('pre_trade', 'during_trade', 'post_trade')),\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  UNIQUE(trade_id, emotion_id, timing)\n);\n\n-- ============================================\n-- 9. TRADE MISTAKES (JUNCTION TABLE)\n-- ============================================\nCREATE TABLE IF NOT EXISTS trade_mistakes (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  trade_id UUID NOT NULL REFERENCES trades(id) ON DELETE CASCADE,\n  mistake_id UUID NOT NULL REFERENCES mistake_tags(id) ON DELETE CASCADE,\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  UNIQUE(trade_id, mistake_id)\n);\n\n-- ============================================\n-- 10. TRADE NOTES TABLE\n-- ============================================\nCREATE TABLE IF NOT EXISTS trade_notes (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  trade_id UUID NOT NULL REFERENCES trades(id) ON DELETE CASCADE,\n  note_type TEXT DEFAULT 'general' CHECK (note_type IN ('general', 'pre_trade', 'during_trade', 'post_trade', 'review')),\n  content TEXT NOT NULL,\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\n-- ============================================\n-- 11. TRADE SCREENSHOTS TABLE\n-- ============================================\nCREATE TABLE IF NOT EXISTS trade_screenshots (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  trade_id UUID NOT NULL REFERENCES trades(id) ON DELETE CASCADE,\n  image_url TEXT NOT NULL,\n  caption TEXT,\n  created_at TIMESTAMPTZ DEFAULT NOW()\n);\n\n-- ============================================\n-- 12. CSV IMPORT LOGS TABLE\n-- ============================================\nCREATE TABLE IF NOT EXISTS csv_import_logs (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  user_id UUID NOT NULL REFERENCES profiles(id) ON DELETE CASCADE,\n  account_id UUID REFERENCES trading_accounts(id) ON DELETE SET NULL,\n  file_name TEXT NOT NULL,\n  broker_format TEXT, -- 'MT4', 'MT5', 'cTrader', etc.\n  status TEXT DEFAULT 'pending' CHECK (status IN ('pending', 'processing', 'completed', 'failed')),\n  total_rows INTEGER DEFAULT 0,\n  imported_rows INTEGER DEFAULT 0,\n  skipped_rows INTEGER DEFAULT 0,\n  error_rows INTEGER DEFAULT 0,\n  error_details JSONB, -- Store error details\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  completed_at TIMESTAMPTZ\n);\n\n-- ============================================\n-- 13. USER SETTINGS TABLE\n-- ============================================\nCREATE TABLE IF NOT EXISTS user_settings (\n  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),\n  user_id UUID NOT NULL UNIQUE REFERENCES profiles(id) ON DELETE CASCADE,\n  preferences JSONB DEFAULT '{}'::jsonb,\n  created_at TIMESTAMPTZ DEFAULT NOW(),\n  updated_at TIMESTAMPTZ DEFAULT NOW()\n);\n\n-- ============================================\n-- INDEXES FOR PERFORMANCE\n-- ============================================\nCREATE INDEX IF NOT EXISTS idx_trades_user_account ON trades(user_id, account_id);\nCREATE INDEX IF NOT EXISTS idx_trades_entry_time ON trades(entry_time);\nCREATE INDEX IF NOT EXISTS idx_trades_currency_pair ON trades(currency_pair);\nCREATE INDEX IF NOT EXISTS idx_trades_status ON trades(status);\nCREATE INDEX IF NOT EXISTS idx_trades_strategy ON trades(strategy_id);\nCREATE INDEX IF NOT EXISTS idx_trades_setup ON trades(setup_id);\nCREATE INDEX IF NOT EXISTS idx_trades_analytics ON trades(user_id, account_id, entry_time, profit_loss);\nCREATE INDEX IF NOT EXISTS idx_trading_accounts_user ON trading_accounts(user_id);\nCREATE INDEX IF NOT EXISTS idx_strategies_user ON strategies(user_id);\nCREATE INDEX IF NOT EXISTS idx_trade_setups_user ON trade_setups(user_id);\nCREATE INDEX IF NOT EXISTS idx_trade_emotions_trade ON trade_emotions(trade_id);\nCREATE INDEX IF NOT EXISTS idx_trade_mistakes_trade ON trade_mistakes(trade_id);\nCREATE INDEX IF NOT EXISTS idx_trade_notes_trade ON trade_notes(trade_id);\nCREATE INDEX IF NOT EXISTS idx_csv_import_logs_user ON csv_import_logs(user_id);\n\n-- ============================================\n-- TRIGGERS FOR UPDATED_AT\n-- ============================================\nCREATE OR REPLACE FUNCTION update_updated_at_column()\nRETURNS TRIGGER AS $$\nBEGIN\n  NEW.updated_at = NOW();\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;\n\nCREATE TRIGGER update_profiles_updated_at BEFORE UPDATE ON profiles\n  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();\n\nCREATE TRIGGER update_trading_accounts_updated_at BEFORE UPDATE ON trading_accounts\n  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();\n\nCREATE TRIGGER update_strategies_updated_at BEFORE UPDATE ON strategies\n  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();\n\nCREATE TRIGGER update_trade_setups_updated_at BEFORE UPDATE ON trade_setups\n  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();\n\nCREATE TRIGGER update_trades_updated_at BEFORE UPDATE ON trades\n  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();\n\nCREATE TRIGGER update_trade_notes_updated_at BEFORE UPDATE ON trade_notes\n  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();\n\nCREATE TRIGGER update_user_settings_updated_at BEFORE UPDATE ON user_settings\n  FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();\n\n-- ============================================\n-- FUNCTION TO AUTO-CREATE PROFILE\n-- ============================================\nCREATE OR REPLACE FUNCTION public.handle_new_user()\nRETURNS TRIGGER AS $$\nBEGIN\n  INSERT INTO public.profiles (id, email, full_name)\n  VALUES (\n    NEW.id,\n    NEW.email,\n    COALESCE(NEW.raw_user_meta_data->>'full_name', NEW.email)\n  );\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql SECURITY DEFINER;\n\nCREATE TRIGGER on_auth_user_created\n  AFTER INSERT ON auth.users\n  FOR EACH ROW EXECUTE FUNCTION public.handle_new_user();\n\n-- ============================================\n-- ROW LEVEL SECURITY (RLS) POLICIES\n-- ============================================\n\n-- Enable RLS on all tables\nALTER TABLE profiles ENABLE ROW LEVEL SECURITY;\nALTER TABLE trading_accounts ENABLE ROW LEVEL SECURITY;\nALTER TABLE strategies ENABLE ROW LEVEL SECURITY;\nALTER TABLE trade_setups ENABLE ROW LEVEL SECURITY;\nALTER TABLE emotion_tags ENABLE ROW LEVEL SECURITY;\nALTER TABLE mistake_tags ENABLE ROW LEVEL SECURITY;\nALTER TABLE trades ENABLE ROW LEVEL SECURITY;\nALTER TABLE trade_emotions ENABLE ROW LEVEL SECURITY;\nALTER TABLE trade_mistakes ENABLE ROW LEVEL SECURITY;\nALTER TABLE trade_notes ENABLE ROW LEVEL SECURITY;\nALTER TABLE trade_screenshots ENABLE ROW LEVEL SECURITY;\nALTER TABLE csv_import_logs ENABLE ROW LEVEL SECURITY;\nALTER TABLE user_settings ENABLE ROW LEVEL SECURITY;\n\n-- PROFILES POLICIES\nCREATE POLICY \\"Users can view own profile\\" ON profiles\n  FOR SELECT USING (auth.uid() = id);\n\nCREATE POLICY \\"Users can update own profile\\" ON profiles\n  FOR UPDATE USING (auth.uid() = id);\n\n-- TRADING ACCOUNTS POLICIES\nCREATE POLICY \\"Users can view own accounts\\" ON trading_accounts\n  FOR SELECT USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can insert own accounts\\" ON trading_accounts\n  FOR INSERT WITH CHECK (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can update own accounts\\" ON trading_accounts\n  FOR UPDATE USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can delete own accounts\\" ON trading_accounts\n  FOR DELETE USING (auth.uid() = user_id);\n\n-- STRATEGIES POLICIES\nCREATE POLICY \\"Users can view own strategies\\" ON strategies\n  FOR SELECT USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can insert own strategies\\" ON strategies\n  FOR INSERT WITH CHECK (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can update own strategies\\" ON strategies\n  FOR UPDATE USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can delete own strategies\\" ON strategies\n  FOR DELETE USING (auth.uid() = user_id);\n\n-- TRADE SETUPS POLICIES\nCREATE POLICY \\"Users can view own setups\\" ON trade_setups\n  FOR SELECT USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can insert own setups\\" ON trade_setups\n  FOR INSERT WITH CHECK (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can update own setups\\" ON trade_setups\n  FOR UPDATE USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can delete own setups\\" ON trade_setups\n  FOR DELETE USING (auth.uid() = user_id);\n\n-- EMOTION TAGS POLICIES\nCREATE POLICY \\"Users can view own emotion tags\\" ON emotion_tags\n  FOR SELECT USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can insert own emotion tags\\" ON emotion_tags\n  FOR INSERT WITH CHECK (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can update own emotion tags\\" ON emotion_tags\n  FOR UPDATE USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can delete own emotion tags\\" ON emotion_tags\n  FOR DELETE USING (auth.uid() = user_id);\n\n-- MISTAKE TAGS POLICIES\nCREATE POLICY \\"Users can view own mistake tags\\" ON mistake_tags\n  FOR SELECT USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can insert own mistake tags\\" ON mistake_tags\n  FOR INSERT WITH CHECK (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can update own mistake tags\\" ON mistake_tags\n  FOR UPDATE USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can delete own mistake tags\\" ON mistake_tags\n  FOR DELETE USING (auth.uid() = user_id);\n\n-- TRADES POLICIES\nCREATE POLICY \\"Users can view own trades\\" ON trades\n  FOR SELECT USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can insert own trades\\" ON trades\n  FOR INSERT WITH CHECK (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can update own trades\\" ON trades\n  FOR UPDATE USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can delete own trades\\" ON trades\n  FOR DELETE USING (auth.uid() = user_id);\n\n-- TRADE EMOTIONS POLICIES\nCREATE POLICY \\"Users can view own trade emotions\\" ON trade_emotions\n  FOR SELECT USING (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_emotions.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\nCREATE POLICY \\"Users can insert own trade emotions\\" ON trade_emotions\n  FOR INSERT WITH CHECK (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_emotions.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\nCREATE POLICY \\"Users can delete own trade emotions\\" ON trade_emotions\n  FOR DELETE USING (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_emotions.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\n-- TRADE MISTAKES POLICIES\nCREATE POLICY \\"Users can view own trade mistakes\\" ON trade_mistakes\n  FOR SELECT USING (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_mistakes.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\nCREATE POLICY \\"Users can insert own trade mistakes\\" ON trade_mistakes\n  FOR INSERT WITH CHECK (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_mistakes.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\nCREATE POLICY \\"Users can delete own trade mistakes\\" ON trade_mistakes\n  FOR DELETE USING (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_mistakes.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\n-- TRADE NOTES POLICIES\nCREATE POLICY \\"Users can view own trade notes\\" ON trade_notes\n  FOR SELECT USING (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_notes.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\nCREATE POLICY \\"Users can insert own trade notes\\" ON trade_notes\n  FOR INSERT WITH CHECK (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_notes.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\nCREATE POLICY \\"Users can update own trade notes\\" ON trade_notes\n  FOR UPDATE USING (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_notes.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\nCREATE POLICY \\"Users can delete own trade notes\\" ON trade_notes\n  FOR DELETE USING (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_notes.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\n-- TRADE SCREENSHOTS POLICIES\nCREATE POLICY \\"Users can view own trade screenshots\\" ON trade_screenshots\n  FOR SELECT USING (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_screenshots.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\nCREATE POLICY \\"Users can insert own trade screenshots\\" ON trade_screenshots\n  FOR INSERT WITH CHECK (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_screenshots.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\nCREATE POLICY \\"Users can delete own trade screenshots\\" ON trade_screenshots\n  FOR DELETE USING (\n    EXISTS (\n      SELECT 1 FROM trades\n      WHERE trades.id = trade_screenshots.trade_id\n      AND trades.user_id = auth.uid()\n    )\n  );\n\n-- CSV IMPORT LOGS POLICIES\nCREATE POLICY \\"Users can view own import logs\\" ON csv_import_logs\n  FOR SELECT USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can insert own import logs\\" ON csv_import_logs\n  FOR INSERT WITH CHECK (auth.uid() = user_id);\n\n-- USER SETTINGS POLICIES\nCREATE POLICY \\"Users can view own settings\\" ON user_settings\n  FOR SELECT USING (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can insert own settings\\" ON user_settings\n  FOR INSERT WITH CHECK (auth.uid() = user_id);\n\nCREATE POLICY \\"Users can update own settings\\" ON user_settings\n  FOR UPDATE USING (auth.uid() = user_id);"}	create_fx_journal_schema	joshuakinywa96@gmail.com	\N	\N
20251203234200	{"-- This function will be called after a user profile is created\n-- to insert default emotion and mistake tags\n\nCREATE OR REPLACE FUNCTION insert_default_tags_for_user(user_uuid UUID)\nRETURNS void AS $$\nBEGIN\n  -- Default emotion tags\n  INSERT INTO emotion_tags (user_id, name, color, is_default)\n  VALUES\n    (user_uuid, 'Confident', '#10B981', true),\n    (user_uuid, 'Calm', '#3B82F6', true),\n    (user_uuid, 'Anxious', '#F59E0B', true),\n    (user_uuid, 'FOMO', '#EF4444', true),\n    (user_uuid, 'Greedy', '#F97316', true),\n    (user_uuid, 'Fearful', '#8B5CF6', true),\n    (user_uuid, 'Satisfied', '#06B6D4', true),\n    (user_uuid, 'Frustrated', '#EC4899', true),\n    (user_uuid, 'Excited', '#84CC16', true),\n    (user_uuid, 'Indifferent', '#6B7280', true)\n  ON CONFLICT (user_id, name) DO NOTHING;\n\n  -- Default mistake tags\n  INSERT INTO mistake_tags (user_id, name, description, is_default)\n  VALUES\n    (user_uuid, 'Moved Stop Loss', 'Moved stop loss against the trade', true),\n    (user_uuid, 'Revenge Trade', 'Traded to recover from a loss', true),\n    (user_uuid, 'Overtraded', 'Took too many trades in a session', true),\n    (user_uuid, 'Ignored Plan', 'Did not follow trading plan', true),\n    (user_uuid, 'Emotional Entry', 'Entered trade based on emotions', true),\n    (user_uuid, 'Early Exit', 'Exited trade before target', true),\n    (user_uuid, 'Late Entry', 'Entered trade too late', true),\n    (user_uuid, 'Wrong Position Size', 'Used incorrect position size', true),\n    (user_uuid, 'No Stop Loss', 'Entered trade without stop loss', true),\n    (user_uuid, 'Held Too Long', 'Held losing trade too long', true)\n  ON CONFLICT (user_id, name) DO NOTHING;\nEND;\n$$ LANGUAGE plpgsql SECURITY DEFINER;\n\n-- Update the handle_new_user function to also insert default tags\nCREATE OR REPLACE FUNCTION public.handle_new_user()\nRETURNS TRIGGER AS $$\nBEGIN\n  INSERT INTO public.profiles (id, email, full_name)\n  VALUES (\n    NEW.id,\n    NEW.email,\n    COALESCE(NEW.raw_user_meta_data->>'full_name', NEW.email)\n  );\n  \n  -- Insert default tags for the new user\n  PERFORM insert_default_tags_for_user(NEW.id);\n  \n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql SECURITY DEFINER;"}	insert_default_tags	joshuakinywa96@gmail.com	\N	\N
20251203235837	{"-- First, ensure the insert_default_tags_for_user function exists\nCREATE OR REPLACE FUNCTION public.insert_default_tags_for_user(user_uuid UUID)\nRETURNS void AS $$\nBEGIN\n  -- Default emotion tags\n  INSERT INTO public.emotion_tags (user_id, name, color, is_default)\n  VALUES\n    (user_uuid, 'Confident', '#10B981', true),\n    (user_uuid, 'Calm', '#3B82F6', true),\n    (user_uuid, 'Anxious', '#F59E0B', true),\n    (user_uuid, 'FOMO', '#EF4444', true),\n    (user_uuid, 'Greedy', '#F97316', true),\n    (user_uuid, 'Fearful', '#8B5CF6', true),\n    (user_uuid, 'Satisfied', '#06B6D4', true),\n    (user_uuid, 'Frustrated', '#EC4899', true),\n    (user_uuid, 'Excited', '#84CC16', true),\n    (user_uuid, 'Indifferent', '#6B7280', true)\n  ON CONFLICT (user_id, name) DO NOTHING;\n\n  -- Default mistake tags\n  INSERT INTO public.mistake_tags (user_id, name, description, is_default)\n  VALUES\n    (user_uuid, 'Moved Stop Loss', 'Moved stop loss against the trade', true),\n    (user_uuid, 'Revenge Trade', 'Traded to recover from a loss', true),\n    (user_uuid, 'Overtraded', 'Took too many trades in a session', true),\n    (user_uuid, 'Ignored Plan', 'Did not follow trading plan', true),\n    (user_uuid, 'Emotional Entry', 'Entered trade based on emotions', true),\n    (user_uuid, 'Early Exit', 'Exited trade before target', true),\n    (user_uuid, 'Late Entry', 'Entered trade too late', true),\n    (user_uuid, 'Wrong Position Size', 'Used incorrect position size', true),\n    (user_uuid, 'No Stop Loss', 'Entered trade without stop loss', true),\n    (user_uuid, 'Held Too Long', 'Held losing trade too long', true)\n  ON CONFLICT (user_id, name) DO NOTHING;\nEND;\n$$ LANGUAGE plpgsql SECURITY DEFINER;\n\n-- Update the handle_new_user function to handle errors gracefully\nCREATE OR REPLACE FUNCTION public.handle_new_user()\nRETURNS TRIGGER AS $$\nBEGIN\n  -- Insert profile\n  INSERT INTO public.profiles (id, email, full_name)\n  VALUES (\n    NEW.id,\n    NEW.email,\n    COALESCE(NEW.raw_user_meta_data->>'full_name', NEW.email)\n  )\n  ON CONFLICT (id) DO NOTHING;\n  \n  -- Insert default tags for the new user (with error handling)\n  BEGIN\n    PERFORM public.insert_default_tags_for_user(NEW.id);\n  EXCEPTION WHEN OTHERS THEN\n    -- Log error but don't fail user creation\n    RAISE WARNING 'Failed to insert default tags for user %: %', NEW.id, SQLERRM;\n  END;\n  \n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql SECURITY DEFINER;"}	fix_user_creation_trigger	joshuakinywa96@gmail.com	\N	\N
20251204080624	{"-- Function to calculate and update account balance\nCREATE OR REPLACE FUNCTION public.update_account_balance(account_uuid UUID)\nRETURNS void AS $$\nDECLARE\n  initial_bal NUMERIC;\n  total_pnl NUMERIC;\n  new_balance NUMERIC;\nBEGIN\n  -- Get initial balance\n  SELECT initial_balance INTO initial_bal\n  FROM public.trading_accounts\n  WHERE id = account_uuid;\n  \n  -- Calculate total P&L from closed trades\n  SELECT COALESCE(SUM(profit_loss), 0) INTO total_pnl\n  FROM public.trades\n  WHERE account_id = account_uuid\n    AND status = 'closed'\n    AND profit_loss IS NOT NULL;\n  \n  -- Calculate new balance\n  new_balance := COALESCE(initial_bal, 0) + COALESCE(total_pnl, 0);\n  \n  -- Update account balance\n  UPDATE public.trading_accounts\n  SET current_balance = new_balance,\n      updated_at = NOW()\n  WHERE id = account_uuid;\nEND;\n$$ LANGUAGE plpgsql SECURITY DEFINER;\n\n-- Trigger to update account balance when trade is updated\nCREATE OR REPLACE FUNCTION public.update_balance_on_trade_change()\nRETURNS TRIGGER AS $$\nBEGIN\n  -- Update balance when trade status changes to closed or profit_loss changes\n  IF (NEW.status = 'closed' AND (OLD.status != 'closed' OR OLD.profit_loss != NEW.profit_loss))\n     OR (NEW.profit_loss != OLD.profit_loss AND NEW.status = 'closed') THEN\n    PERFORM public.update_account_balance(NEW.account_id);\n  END IF;\n  \n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql SECURITY DEFINER;\n\n-- Create trigger\nDROP TRIGGER IF EXISTS trigger_update_balance_on_trade_change ON public.trades;\nCREATE TRIGGER trigger_update_balance_on_trade_change\n  AFTER INSERT OR UPDATE ON public.trades\n  FOR EACH ROW\n  EXECUTE FUNCTION public.update_balance_on_trade_change();\n\n-- Add risk management fields to trades table if they don't exist\nDO $$ \nBEGIN\n  -- Risk per trade (as % of account)\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns \n    WHERE table_name = 'trades' AND column_name = 'risk_percentage'\n  ) THEN\n    ALTER TABLE public.trades ADD COLUMN risk_percentage NUMERIC(5,2);\n  END IF;\n  \n  -- R-multiple (risk:reward ratio)\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns \n    WHERE table_name = 'trades' AND column_name = 'r_multiple'\n  ) THEN\n    ALTER TABLE public.trades ADD COLUMN r_multiple NUMERIC(10,2);\n  END IF;\n  \n  -- Risk amount in currency\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns \n    WHERE table_name = 'trades' AND column_name = 'risk_amount'\n  ) THEN\n    ALTER TABLE public.trades ADD COLUMN risk_amount NUMERIC(10,2);\n  END IF;\n  \n  -- Discipline score (1-10)\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns \n    WHERE table_name = 'trades' AND column_name = 'discipline_score'\n  ) THEN\n    ALTER TABLE public.trades ADD COLUMN discipline_score INTEGER CHECK (discipline_score >= 1 AND discipline_score <= 10);\n  END IF;\n  \n  -- Risk management score (1-10)\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns \n    WHERE table_name = 'trades' AND column_name = 'risk_management_score'\n  ) THEN\n    ALTER TABLE public.trades ADD COLUMN risk_management_score INTEGER CHECK (risk_management_score >= 1 AND risk_management_score <= 10);\n  END IF;\n  \n  -- Missing details flag\n  IF NOT EXISTS (\n    SELECT 1 FROM information_schema.columns \n    WHERE table_name = 'trades' AND column_name = 'has_missing_details'\n  ) THEN\n    ALTER TABLE public.trades ADD COLUMN has_missing_details BOOLEAN DEFAULT false;\n  END IF;\nEND $$;\n\n-- Function to check for missing details\nCREATE OR REPLACE FUNCTION public.check_missing_trade_details()\nRETURNS TRIGGER AS $$\nBEGIN\n  -- Check if trade has missing critical details\n  NEW.has_missing_details := (\n    NEW.stop_loss IS NULL OR\n    NEW.take_profit IS NULL OR\n    NEW.strategy_id IS NULL OR\n    NEW.notes IS NULL OR\n    (NEW.status = 'closed' AND NEW.profit_loss IS NULL) OR\n    (NEW.status = 'closed' AND NEW.exit_time IS NULL) OR\n    (NEW.status = 'closed' AND NEW.exit_price IS NULL)\n  );\n  \n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql SECURITY DEFINER;\n\n-- Create trigger for missing details\nDROP TRIGGER IF EXISTS trigger_check_missing_details ON public.trades;\nCREATE TRIGGER trigger_check_missing_details\n  BEFORE INSERT OR UPDATE ON public.trades\n  FOR EACH ROW\n  EXECUTE FUNCTION public.check_missing_trade_details();\n"}	add_risk_management_and_balance_calc	joshuakinywa96@gmail.com	\N	\N
\.


