--
-- Name: trades; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.trades (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    user_id uuid NOT NULL,
    account_id uuid NOT NULL,
    ticket_id text,
    currency_pair text NOT NULL,
    direction text NOT NULL,
    entry_time timestamp with time zone NOT NULL,
    entry_price numeric(15,5) NOT NULL,
    position_size numeric(15,2) NOT NULL,
    exit_time timestamp with time zone,
    exit_price numeric(15,5),
    stop_loss numeric(15,5),
    take_profit numeric(15,5),
    risk_amount numeric(15,2),
    risk_reward_ratio numeric(10,2),
    profit_loss numeric(15,2) DEFAULT 0,
    pips numeric(10,2),
    r_multiple numeric(10,2),
    conviction_level integer,
    market_conditions text,
    rule_followed boolean,
    execution_rating integer,
    lessons_learned text,
    strategy_id uuid,
    setup_id uuid,
    status text DEFAULT 'open'::text,
    notes text,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    risk_percentage numeric(5,2),
    discipline_score integer,
    risk_management_score integer,
    has_missing_details boolean DEFAULT false,
    CONSTRAINT trades_conviction_level_check CHECK (((conviction_level >= 1) AND (conviction_level <= 10))),
    CONSTRAINT trades_direction_check CHECK ((direction = ANY (ARRAY['buy'::text, 'sell'::text]))),
    CONSTRAINT trades_discipline_score_check CHECK (((discipline_score >= 1) AND (discipline_score <= 10))),
    CONSTRAINT trades_execution_rating_check CHECK (((execution_rating >= 1) AND (execution_rating <= 10))),
    CONSTRAINT trades_risk_management_score_check CHECK (((risk_management_score >= 1) AND (risk_management_score <= 10))),
    CONSTRAINT trades_status_check CHECK ((status = ANY (ARRAY['open'::text, 'closed'::text, 'pending'::text])))
);


ALTER TABLE public.trades OWNER TO postgres;

